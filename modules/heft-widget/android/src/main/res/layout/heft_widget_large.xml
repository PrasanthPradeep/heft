<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/heft_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/heft_widget_bg"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="30dp"
      android:layout_height="30dp"
      android:background="@drawable/heft_widget_icon_bg"
      android:contentDescription="@null"
      android:padding="6dp"
      android:src="@drawable/heft_widget_drop" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/heft_widget_title_large"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/heft_widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/heft_widget_subtitle"
        android:textColor="#8FA79A"
        android:textSize="10sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/heft_widget_dots"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:contentDescription="@string/heft_widget_open_description"
      android:includeFontPadding="false"
      android:padding="4dp"
      android:text="···"
      android:textColor="#8FA79A"
      android:textSize="16sp" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:baselineAligned="true"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/heft_widget_total"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="750 ml"
      android:textColor="#FFFFFF"
      android:textSize="25sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/heft_widget_goal"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="5dp"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="of 2,000 ml"
      android:textColor="#9FB8AA"
      android:textSize="12sp" />
  </LinearLayout>

  <ProgressBar
    android:id="@+id/heft_widget_progress"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="6dp"
    android:layout_marginTop="8dp"
    android:max="1000"
    android:progress="375"
    android:progressDrawable="@drawable/heft_widget_progress" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/heft_widget_percent"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="37.5% completed"
      android:textColor="#6EE7AE"
      android:textSize="11sp" />

    <TextView
      android:id="@+id/heft_widget_remaining"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="1,250 ml left"
      android:textColor="#C7D8CE"
      android:textSize="11sp" />
  </LinearLayout>

  <TextView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/heft_widget_add_150"
      android:layout_width="0dp"
      android:layout_height="32dp"
      android:layout_weight="1"
      android:background="@drawable/heft_widget_button"
      android:gravity="center"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="@string/heft_widget_add_150"
      android:textColor="#A9EFC9"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/heft_widget_add_250"
      android:layout_width="0dp"
      android:layout_height="32dp"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:background="@drawable/heft_widget_button"
      android:gravity="center"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="@string/heft_widget_add_250"
      android:textColor="#A9EFC9"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/heft_widget_add_500"
      android:layout_width="0dp"
      android:layout_height="32dp"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:background="@drawable/heft_widget_button"
      android:gravity="center"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="@string/heft_widget_add_500"
      android:textColor="#A9EFC9"
      android:textSize="12sp"
      android:textStyle="bold" />
  </LinearLayout>

</LinearLayout>
